# Environment configuration template
# Copy to .env.local and update values as needed

# Local development: use local FastAPI backend
# VITE_API_URL=http://127.0.0.1:8000

# Production: use deployed Render backend
# VITE_API_URL=https://sara-9u4x.onrender.com

# If VITE_API_URL is not set, the frontend will use relative paths (works with Vite proxy in local dev)
